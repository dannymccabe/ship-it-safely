# Environment variable NAMES for the contact form.
# Never put real values in this file or in your code.
# Add the values in the Vercel dashboard: Project > Settings > Environment Variables.

# Sending-only API key from resend.com (API Keys > Create API Key)
RESEND_API_KEY=

# Where form submissions arrive, e.g. you@yourdomain.com
CONTACT_TO_EMAIL=

# An address on your Resend-verified domain, e.g. Website <hello@yourdomain.com>
CONTACT_FROM_EMAIL=
